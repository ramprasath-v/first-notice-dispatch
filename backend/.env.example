GOOGLE_CLOUD_PROJECT=firstnotice-ai
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
FIRESTORE_DATABASE=firstnotice-app
PUBSUB_CLAIM_EVENTS_TOPIC=firstnotice-claim-events
GCS_CLAIM_BUCKET=firstnotice-ai-claim-evidence
ALLOWED_ORIGINS=http://localhost:4200
GOOGLE_CALENDAR_ENABLED=false
# Secondary "FirstNotice Demo Inspections" calendar owned by the dedicated
# adjuster demo account and shared with the runtime service account.
GOOGLE_CALENDAR_ID=<secondary-calendar-id>
GMAIL_NOTIFICATION_ENABLED=false
ADJUSTER_EMAIL=firstnotice.adjuster@gmail.com
FIRSTNOTICE_WEB_BASE_URL=http://localhost:4200
HUMAN_REVIEW_TOKEN_TTL_MINUTES=60
GMAIL_SENDER_EMAIL=firstnotice.adjuster@gmail.com
# Inject these three values from Secret Manager when Gmail is enabled.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
