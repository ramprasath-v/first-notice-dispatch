GOOGLE_CLOUD_PROJECT=<your-google-cloud-project-id>
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
FIRESTORE_DATABASE=<your-firestore-database>
PUBSUB_CLAIM_EVENTS_TOPIC=<your-claim-events-topic>
GCS_CLAIM_BUCKET=<your-evidence-bucket>
ALLOWED_ORIGINS=<https://your-frontend-url>
GOOGLE_CALENDAR_ENABLED=false
# Secondary calendar shared with the runtime service account.
GOOGLE_CALENDAR_ID=<your-calendar-id>
GMAIL_NOTIFICATION_ENABLED=false
ADJUSTER_EMAIL=<adjuster-email@example.com>
FIRSTNOTICE_WEB_BASE_URL=https://firstnotice-web-905025655505.us-central1.run.app
HUMAN_REVIEW_TOKEN_TTL_MINUTES=60
GMAIL_SENDER_EMAIL=<gmail-sender@example.com>
# Inject these three values from Secret Manager when Gmail is enabled.
GMAIL_OAUTH_CLIENT_ID=<gmail-oauth-client-id>
GMAIL_OAUTH_CLIENT_SECRET=<gmail-oauth-client-secret>
GMAIL_OAUTH_REFRESH_TOKEN=<gmail-oauth-refresh-token>
